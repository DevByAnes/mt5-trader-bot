{
  "name": "xauusd-operations-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript schema/openapi.yaml -o src/shared/api/generated.ts",
    "tauri": "tauri",
    "contract:check": "node scripts/contract-check.mjs",
    "screenshots": "node scripts/capture.mjs after"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-table": "latest",
    "@tauri-apps/api": "^2.12.3",
    "i18next": "latest",
    "lightweight-charts": "latest",
    "lucide-react": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "latest",
    "react-i18next": "latest",
    "react-router-dom": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "msw": "latest",
    "openapi-typescript": "latest",
    "pnpm": "^12.16.1",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^8.3.0",
    "vitest": "latest"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
