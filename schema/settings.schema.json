{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XAUUSD EA Settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "executionMode": {
      "key": "executionMode",
      "type": "string",
      "enum": [
        "SIGNAL_ONLY",
        "PAPER",
        "LIVE"
      ],
      "default": "SIGNAL_ONLY",
      "group": "execution",
      "label_i18n": "settings.executionMode",
      "help_i18n": "settings.executionModeHelp",
      "risk_level": "HIGH",
      "apply": "COLD",
      "risk_direction": "NONE",
      "mt5_only": false,
      "min": null,
      "max": null,
      "step": null
    },
    "riskPerTrade": {
      "key": "riskPerTrade",
      "type": "number",
      "minimum": 0.1,
      "maximum": 2,
      "multipleOf": 0.1,
      "default": 0.5,
      "group": "risk",
      "label_i18n": "settings.riskPerTrade",
      "help_i18n": "settings.riskPerTradeHelp",
      "risk_level": "HIGH",
      "apply": "COLD",
      "risk_direction": "HIGHER_IS_LOOSER",
      "mt5_only": false,
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "enum": null
    },
    "dailyLossLimit": {
      "key": "dailyLossLimit",
      "type": "number",
      "minimum": 0.5,
      "maximum": 5,
      "multipleOf": 0.1,
      "default": 2,
      "group": "daily",
      "label_i18n": "settings.dailyLossLimit",
      "help_i18n": "settings.dailyLossLimitHelp",
      "risk_level": "HIGH",
      "apply": "COLD",
      "risk_direction": "HIGHER_IS_LOOSER",
      "mt5_only": false,
      "min": 0.5,
      "max": 5,
      "step": 0.1,
      "enum": null
    },
    "maxSpread": {
      "key": "maxSpread",
      "type": "number",
      "minimum": 5,
      "maximum": 100,
      "multipleOf": 1,
      "default": 35,
      "group": "filters",
      "label_i18n": "settings.maxSpread",
      "help_i18n": "settings.maxSpreadHelp",
      "risk_level": "MEDIUM",
      "apply": "HOT",
      "risk_direction": "HIGHER_IS_LOOSER",
      "mt5_only": false,
      "min": 5,
      "max": 100,
      "step": 1,
      "enum": null
    },
    "allowRemoteConfig": {
      "key": "allowRemoteConfig",
      "type": "boolean",
      "default": false,
      "group": "bridge",
      "label_i18n": "settings.allowRemoteConfig",
      "help_i18n": "settings.mt5Only",
      "risk_level": "HIGH",
      "apply": "COLD",
      "risk_direction": "NONE",
      "mt5_only": true,
      "min": null,
      "max": null,
      "step": null,
      "enum": null
    },
    "allowRealAccount": {
      "key": "allowRealAccount",
      "type": "boolean",
      "default": false,
      "group": "execution",
      "label_i18n": "settings.allowRealAccount",
      "help_i18n": "settings.mt5Only",
      "risk_level": "HIGH",
      "apply": "COLD",
      "risk_direction": "NONE",
      "mt5_only": true,
      "min": null,
      "max": null,
      "step": null,
      "enum": null
    }
  },
  "required": [
    "executionMode",
    "riskPerTrade",
    "dailyLossLimit",
    "maxSpread",
    "allowRemoteConfig",
    "allowRealAccount"
  ]
}
